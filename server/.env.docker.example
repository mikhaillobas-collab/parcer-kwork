# Настройки для сервера Docker
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Ссылка на страницу биржи Kwork с вашими примененными фильтрами
KWORK_URL=https://kwork.ru/projects

# Режим работы:
# true = безопасный тест со скриншотом (отклики НЕ списываются)
# false = боевой режим (отправка откликов)
DRY_RUN=true

# На сервере всегда true (без графического окна)
HEADLESS=true

# Фильтры:
MAX_EXISTING_OFFERS=10
MIN_ACCEPTABLE_PRICE=3000

# Интервалы проверки в секундах
CHECK_INTERVAL_MIN=60
CHECK_INTERVAL_MAX=120

# Telegram-уведомления (бот будет присылать отчеты и скриншоты в чат)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
