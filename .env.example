# Нейросеть для анализа заказов: любой OpenAI-совместимый API (по умолчанию DeepSeek, ключ: https://platform.deepseek.com/api_keys)
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
# Запасные модели через запятую (если основная вернула ошибку)
LLM_FALLBACK_MODELS=deepseek-flash
# Дешёвая модель для предварительного отбора заказов (пусто — отбор отключён, всё анализирует LLM_MODEL)
LLM_SCREEN_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# Прокси для запросов к нейросети (необязательно)
# Пример: http://login:password@ip:port или socks5://login:password@ip:port
LLM_PROXY=

# Ссылка на биржу Kwork с вашими фильтрами (например: https://kwork.ru/projects?c=all)
KWORK_URL=https://kwork.ru/projects


# Режим работы (true = безопасный тест со скриншотом без списания отклика; false = отправка)
DRY_RUN=true

# Режим браузера (false = окно на экране; true = скрытый фоновый режим для сервера)
HEADLESS=false

# Фильтры биржи
MAX_EXISTING_OFFERS=10
MIN_ACCEPTABLE_PRICE=3000

# Интервал проверки биржи в секундах
CHECK_INTERVAL_MIN=60
CHECK_INTERVAL_MAX=120

# Telegram-уведомления (отчеты и скриншоты откликов)
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш личный числовой Telegram ID (от @userinfobot) — уведомления только вам!
TELEGRAM_CHAT_ID=

