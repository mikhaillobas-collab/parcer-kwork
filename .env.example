# Основная нейросеть — Gemini (ключ: https://aistudio.google.com/apikey). Без ключа работает только запасная нейросеть ниже.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Запасные модели Gemini через запятую (перебираются по очереди, если основная вернула ошибку).
# Лёгкая модель в конце списка: у неё дневной лимит запросов намного больше, чем у моделей Flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash-lite
# Дешёвая модель Gemini для отбора заказов — используется, если запасная нейросеть недоступна
GEMINI_SCREEN_MODEL=gemini-3.5-flash-lite
# Прокси для запросов к Gemini (необязательно) — если Google блокирует доступ по стране
GEMINI_PROXY=
# Адрес API Gemini (пусто — стандартный адрес Google)
GEMINI_BASE_URL=

# Запасная нейросеть: любой OpenAI-совместимый API (по умолчанию DeepSeek, ключ: https://platform.deepseek.com/api_keys)
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
# Запасные модели через запятую (если основная вернула ошибку)
LLM_FALLBACK_MODELS=deepseek-flash
# Дешёвая модель для предварительного отбора новых карточек — спрашивается первой, чтобы беречь лимиты Gemini
# (пусто — отбор делает только дешёвая модель Gemini)
LLM_SCREEN_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# Прокси для запросов к нейросети (необязательно)
# Пример: http://login:password@ip:port или socks5://login:password@ip:port
LLM_PROXY=

# База данных PostgreSQL (строка подключения из панели Bothost → «Базы данных»).
# Если не задана — заказы хранятся в локальном файле SQLite. При первом запуске с PostgreSQL заказы из SQLite переносятся автоматически.
DATABASE_URL=

# Рубрики биржи: бот открывает вкладку «Любимые» (https://kwork.ru/projects?a=1).
# Список рубрик настраивается на самом Kwork — отметьте нужные рубрики звёздочкой, переменная для этого не нужна.


# Режим работы (true = безопасный тест со скриншотом без списания отклика; false = отправка)
DRY_RUN=true

# Режим браузера (false = окно на экране; true = скрытый фоновый режим для сервера)
HEADLESS=false

# Фильтры биржи
MAX_EXISTING_OFFERS=10
MIN_ACCEPTABLE_PRICE=3000

# Интервал проверки биржи в секундах
CHECK_INTERVAL_MIN=60
CHECK_INTERVAL_MAX=120

# Telegram-уведомления (отчеты и скриншоты откликов)
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш личный числовой Telegram ID (от @userinfobot) — уведомления только вам!
TELEGRAM_CHAT_ID=

